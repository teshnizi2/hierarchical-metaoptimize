+            first = buf[0].reshape(-1)[0]
+            man['beta_init'] = b_init
+            man['sched_init_gap'] = float(first) - b_init
+            self._sched_buf = buf
+            self._sched_1d = (buf.dim() == 1)
+            self._bsched_hook = True
